{
  "name": "roomscouter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "demo:seed": "node scripts/seed-local-demo.mjs",
    "deployment:check": "node --env-file-if-exists=.env.local scripts/check-deployment-readiness.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e:local": "node scripts/run-local-e2e.mjs",
    "release:check": "npm run deployment:check && npm test && npm run typecheck && npm run lint && npm run build",
    "types:database": "node scripts/generate-database-types.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "supabase": "2.118.0",
    "typescript": "^6.0.0"
  }
}
